# Copy to .env.local and fill in. Never commit .env files.

# Neon Postgres, pooled connection string of the branch to use
# (development branch locally; in Vercel the Neon integration sets it for
# production only).
DATABASE_URL=
# Optional direct connection, used only for migrations. The Neon integration
# sets it in Vercel; locally migrations fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Better Auth. Secret: at least 32 random characters (openssl rand -base64 32),
# a different one in each environment.
BETTER_AUTH_SECRET=
# Public URL of the app. In Vercel it defaults to the production domain.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud > Google Auth Platform > Clients).
# Required in production, where it is the only way in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The app's only user: the one Google account allowed in. Locally it is also
# the seeded development user.
ADMIN_EMAIL=
# Development only: password of the seeded user, for local logins and the
# end-to-end tests. Production has no password login.
ADMIN_PASSWORD=

# Time zone that decides what day "today" is.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Pins "today" (YYYY-MM-DD) in development and tests. Ignored in production.
APP_FAKE_TODAY=2026-10-05
