# Copy to .env.local and fill in. Never commit .env files.

# Neon Postgres, pooled connection string of the branch to use
# (development branch locally, production branch only in Vercel).
DATABASE_URL=

# Better Auth. Secret: at least 32 random characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Public URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# The single user. Read only by the user-creation script and the seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Time zone that decides what day "today" is.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Pins "today" (YYYY-MM-DD) in development and tests. Ignored in production.
APP_FAKE_TODAY=2026-10-05
